{
  // Editor
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.tabSize": 2,
  "editor.rulers": [100, 120],
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,

  // Files
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",

  // Explorer noise reduction
  "files.exclude": {
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.git": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/target": true,
    "**/dist": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.svelte-kit": true,
    "**/.turbo": true,
    "**/.wrangler": true,
    "**/.cache": true,
    "**/.parcel-cache": true,
    "**/coverage": true,
    "**/.nyc_output": true,
    "**/.tanstack": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/.wrangler/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/target": true,
    "**/.venv": true,
    "**/coverage": true,
    "**/*.gen.ts": true,
    "**/routeTree.gen.ts": true,
    "**/bun.lock": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true,
    "**/uv.lock": true,
    "**/poetry.lock": true,
    "**/Cargo.lock": true
  },

  // File nesting: keep the explorer tidy
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lock, bun.lockb, .npmrc, .nvmrc, .node-version, tsconfig*.json, biome.json, .biomeignore, .prettier*, .eslintrc*, vite.config*, vitest.config*, wrangler.toml, wrangler.jsonc",
    "pyproject.toml": "uv.lock, poetry.lock, requirements*.txt, .python-version, ruff.toml, .ruff.toml, mypy.ini",
    "Cargo.toml": "Cargo.lock, rust-toolchain*, rustfmt.toml, .cargo/config.toml",
    "Package.swift": "Package.resolved, .swift-version, .swiftformat",
    "Dockerfile": "compose.yaml, compose.*.yaml, docker-compose.yml, docker-compose.*.yml, .dockerignore",
    ".gitignore": ".gitattributes",
    "README.md": "CHANGELOG.md, LICENSE*, CONTRIBUTING.md, CODE_OF_CONDUCT.md, SECURITY.md, AUTHORS*",
    "*.ts": "$(capture).test.ts, $(capture).spec.ts, $(capture).d.ts",
    "*.tsx": "$(capture).test.tsx, $(capture).spec.tsx, $(capture).module.css"
  },

  // Diff
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.pruneOnFetch": true,
  "git.branchProtection": ["main", "master", "develop"],

  // Terminal
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.linux": "zsh",
  // tasks.json cannot say where its terminal opens, so the start-agents task lands
  // wherever this points. The editor area gives the three tmux panes enough room.
  // Applies to every terminal in the workspace, not just the task.
  "terminal.integrated.defaultLocation": "editor",

  // Formatters — universal fallbacks only
  // Stack-specific formatters (biome / ruff / rust-analyzer / swift-format) live in each example's .vscode/settings.json
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },

  // ─── Python stack (from examples/python) ─────────────────────────────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },

  "python.defaultInterpreterPath": "/home/vscode/app/.venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,

  "ruff.importStrategy": "fromEnvironment",
  "ruff.nativeServer": "on",

  // ─── Project-specific ────────────────────────────────────────────────
  "debug.internalConsoleOptions": "neverOpen",
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.experimental.showMoves": true,
  "scm.defaultViewMode": "tree"
}
