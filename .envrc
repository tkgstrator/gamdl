# uv keeps the project venv at .venv (see UV_PROJECT_ENVIRONMENT in devcontainer.json).
# Put it on PATH so gamdl / ruff / mypy / pytest run without `uv run` or an explicit
# .venv/bin prefix. Guarded because the venv only exists once postCreateCommand.sh ran.
if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi